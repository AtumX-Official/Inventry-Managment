rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Keep in sync with ADMIN_EMAIL in src/roles.ts.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'info@atumx.in'
        && request.auth.token.email_verified == true;
    }

    // Only verified company Google accounts get any access. Keep in sync with ALLOWED_DOMAIN in src/roles.ts.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@atumx[.]in$');
    }

    // Each person can manage their own profile; the admin can see everyone's.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Everyone signed in can see stock; only the admin can change it.
    match /components/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Only the admin records deliveries and returns; users can read the ones made to them.
    match /deliveries/{id} {
      allow read, write: if isAdmin();
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Users create pending requests for themselves and can read their own;
    // only the admin can accept, reject or delete them.
    match /requests/{id} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
